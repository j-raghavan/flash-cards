# Caddy configuration baked into the web image (apps/web/Dockerfile).
#
# One origin for the whole site: the built single-page app at the root and the
# API under /api, so the session cookie (SameSite=Lax) and the CSP's 'self'
# cover both. The API sends no CORS headers and must stay on this origin.
#
# It listens on plain HTTP: TLS is terminated in front of it, by the compose
# "proxy" profile (deploy/compose/Caddyfile) or by a reverse proxy on the host.
{
	admin off
	auto_https off
	# Keep X-Forwarded-For/-Proto from a TLS proxy in front (on a private
	# network), so the API and the HSTS rule below see the original request.
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	# Above the largest API upload (40 MB for .apkg). Larger requests are
	# refused here, before the API reads them into memory.
	request_body {
		max_size 50MB
	}

	header {
		# Must match CONTENT_SECURITY_POLICY in vite.config.ts (checked by
		# src/deploy.test.ts). frame-ancestors only works as a header.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-Via
	}

	# HSTS only when the request reached the TLS proxy over HTTPS; browsers
	# ignore it over plain HTTP anyway.
	@https header X-Forwarded-Proto https
	header @https Strict-Transport-Security "max-age=31536000"

	# The API, with the /api prefix stripped: /api/decks reaches /decks.
	handle_path /api/* {
		reverse_proxy {$FLASHCARDS_API_UPSTREAM:api:8000} {
			# Write every response chunk as it arrives. Required for the
			# Server-Sent Events of GET /ai/jobs/{id}/events, harmless elsewhere.
			flush_interval -1
		}
	}

	# Never answer an /api path with the app shell, even a bare /api.
	handle /api {
		respond 404
	}

	# Vite's content-hashed build output: safe to cache forever. A missing
	# file is a 404, never index.html, so it cannot be cached as a script.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		file_server
	}

	# Everything else: index.html, sw.js, the manifest and icons, revalidated
	# on every use so a new release (and its service worker) is picked up at
	# once. Paths that are not files get index.html for client-side routing.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
