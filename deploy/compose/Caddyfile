# Caddy front end for deploy/compose (profile "proxy"): terminates HTTPS and
# forwards the whole site to the web service.
# FLASHCARDS_DOMAIN must resolve to this host for automatic HTTPS to work.
#
# Routing (/api to the API, the app everywhere else), caching and the security
# headers, including the Content-Security-Policy, are set by the web service
# (apps/web/Caddyfile). HSTS is sent there for requests that arrived over HTTPS.

{$FLASHCARDS_DOMAIN} {
	# Above the largest API upload (40 MB for .apkg). The web service applies the
	# same limit; refusing here keeps oversized bodies off the internal network.
	request_body {
		max_size 50MB
	}

	header {
		-Server
		-Via
	}

	reverse_proxy web:8080 {
		# Pass Server-Sent Events (GET /api/ai/jobs/{id}/events) through as
		# they arrive.
		flush_interval -1
	}
}
