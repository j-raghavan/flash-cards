# SPDX-License-Identifier: AGPL-3.0-only
# Template for deploy/compose/.env. Copy it, then edit:
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored. Never commit a filled-in copy.
#
# Optional settings are commented out. Leave a setting commented rather than
# setting it to an empty value: an empty value is read as an empty string, not
# as "unset" (for example, an empty FLASHCARDS_SMTP_PORT fails at startup).
# Every FLASHCARDS_* setting is defined in apps/api/src/flashcards/config.py.

# ---------------------------------------------------------------------------
# Compose (read by compose.yaml, not by the application)
# ---------------------------------------------------------------------------

# Required. Postgres password for the "flashcards" role. It is embedded in a
# connection URL, so use URL-safe characters only, e.g. `openssl rand -hex 32`.
# Left empty on purpose: compose refuses to start until it is set.
POSTGRES_PASSWORD=

# Host port the site (web app, with the API under /api) is published on, plain
# HTTP. Default 8000.
# FLASHCARDS_HTTP_PORT=8000
# Address it listens on. Default 127.0.0.1 (this host only, behind an HTTPS
# proxy). 0.0.0.0 serves the whole local network over plain HTTP; then also set
# FLASHCARDS_SESSION_COOKIE_SECURE=false (see "Home network over plain HTTP" in
# docs/runbooks/self-hosting-compose.md).
# FLASHCARDS_HTTP_BIND=127.0.0.1

# Public host name for the optional Caddy proxy (profile "proxy").
# FLASHCARDS_DOMAIN=flashcards.example.org

# Tag for the locally built API and web images. Default "local".
# FLASHCARDS_IMAGE_TAG=local

# Where Postgres keeps its data. Default: the named volume "pgdata". Set a host
# directory to keep it where host backups can see it, e.g. on a Synology:
# FLASHCARDS_PGDATA=/volume1/docker/flash-cards/pgdata

# Automatic database backups (the "backup" service, deploy/compose/backup.sh):
# directory, how many to keep, and hours between backups.
# FLASHCARDS_BACKUP_DIR=./backups
# FLASHCARDS_BACKUP_KEEP=14
# FLASHCARDS_BACKUP_INTERVAL_HOURS=24

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# "production" disables the interactive API docs (/docs, /openapi.json) and
# keeps email bodies (which contain reset links) out of the logs. The image
# already defaults to production. Never use "development" on a public instance.
FLASHCARDS_ENVIRONMENT=production

# FLASHCARDS_DATABASE_URL is set by compose.yaml from POSTGRES_PASSWORD and the
# bundled database service. A value here is overridden; to use an external
# database, edit the FLASHCARDS_DATABASE_URL line in compose.yaml.

# Required. The public HTTPS origin users open (the web app), with no trailing
# slash and no /api suffix. Verification and password-reset emails link to the
# web app's pages here, for example <origin>/verify-email#token=...
FLASHCARDS_PUBLIC_BASE_URL=https://flashcards.example.org

# Session cookie Secure flag. Keep true: the instance must be served over
# HTTPS. false is only for local plain-HTTP testing; with true, browsers do
# not send the cookie over http://, so sign-in appears to fail.
FLASHCARDS_SESSION_COOKIE_SECURE=true

# With true (the default), sign-up requires an invite. With false, anyone can
# create an account at /auth/register: attempts are throttled per client, and
# sign-in requires a confirmed email address (ADR 0016).
FLASHCARDS_INVITE_ONLY=true

# AI cost tracking and limits (ADR 0016). Prices are what the provider charges
# in US dollars per million tokens; with zero, tokens are recorded but no cost,
# and the spend cap has no effect. Admins can change the page limit and the cap
# later at /admin/quotas.
# FLASHCARDS_AI_INPUT_USD_PER_MTOK=0
# FLASHCARDS_AI_OUTPUT_USD_PER_MTOK=0
# The default monthly AI-page limit for members. Unset or empty means no limit
# (ADR 0027): members' pages are counted for the usage report but generation is
# never refused by the quota, leaving the spend cap as the only brake. Set a number
# to meter members instead; admins can also change it later at /admin/quotas.
# FLASHCARDS_AI_DEFAULT_MONTHLY_PAGES=10
# FLASHCARDS_AI_MONTHLY_SPEND_CAP_USD=
# Shown in the AI data-use disclosure; set both for a self-hosted endpoint.
# FLASHCARDS_AI_PROVIDER_NAME=
# FLASHCARDS_AI_PROVIDER_TERMS_URL=

# Most pages (or transcript chunks) a member's AI source document may have, for
# card generation and document chat. Larger documents are refused with 413, which
# states the page count and the limit. Admins have no page cap (ADR 0022). Pages
# are processed one at a time, so this bounds a job's time and cost, not memory.
# At least 1.
# FLASHCARDS_MAX_UPLOAD_PAGES=300

# Privacy policy, terms and imprint (F-LEGAL-1): a directory inside the api
# container holding privacy.md, terms.md and imprint.md, read at startup. Missing
# files show an unfilled template. See docs/runbooks/self-hosting-compose.md.
# FLASHCARDS_LEGAL_DIR=/etc/flashcards/legal

# Automatic YouTube transcripts (ADR 0020). Off by default; when on, the API
# contacts youtube.com for each YouTube link a user submits. Languages are tried
# in order, then any transcript the video has.
# FLASHCARDS_YOUTUBE_TRANSCRIPTS_ENABLED=false
# FLASHCARDS_YOUTUBE_TRANSCRIPT_LANGUAGES=en
# FLASHCARDS_YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=10

# Development only: seeds an admin invite at startup in in-memory mode. Ignored
# in production and whenever a database is configured. Keep false.
FLASHCARDS_DEV_BOOTSTRAP_INVITE=false

# Synchronous AI requests (grading, summaries, mock exams, chat) and deck clones
# running at once. Keep below the database connection pool size.
# FLASHCARDS_MAX_CONCURRENT_AI_CALLS=4

# ---------------------------------------------------------------------------
# AI provider (optional). Without one, AI features answer "unavailable".
# ---------------------------------------------------------------------------

# "anthropic" (default) or "openai_compatible" (LM Studio, Ollama, vLLM, ...).
# FLASHCARDS_LLM_PROVIDER=anthropic

# Anthropic: AI is enabled when the key is set.
# FLASHCARDS_ANTHROPIC_API_KEY=
# FLASHCARDS_ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI-compatible endpoint, used only when FLASHCARDS_LLM_PROVIDER is
# openai_compatible. The base URL is the API root, e.g. http://ollama:11434/v1.
# The key is optional for most local servers.
# FLASHCARDS_OPENAI_BASE_URL=
# FLASHCARDS_OPENAI_API_KEY=
# FLASHCARDS_OPENAI_MODEL=local-model
# FLASHCARDS_OPENAI_TIMEOUT_SECONDS=300
# OpenAI's reasoning models (GPT-5, the o-series) refuse max_tokens. For them,
# send max_completion_tokens and a low reasoning effort, which leaves room in the
# output budget for the answer:
# FLASHCARDS_OPENAI_OUTPUT_LIMIT_FIELD=max_completion_tokens
# FLASHCARDS_OPENAI_REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# Two-factor sign-in (optional, ADR 0018). Authenticator-app (TOTP) secrets are
# encrypted with these keys: comma-separated, newest first. Generate one with
#   openssl rand -base64 32 | tr "+/" "-_"
#   (or, once running: docker compose exec api flashcards generate-totp-key)
# Without a key, authenticator apps are unavailable; passkeys still work. Back
# the key up apart from the database: without it no stored app can be used.
# To rotate: put a new key in front, restart, run
#   docker compose exec api flashcards rotate-totp-key
# then remove the old key.
# ---------------------------------------------------------------------------

# FLASHCARDS_TOTP_ENCRYPTION_KEYS=

# ---------------------------------------------------------------------------
# Outgoing mail (optional). Without FLASHCARDS_SMTP_HOST no mail is sent:
# verification and password-reset emails are dropped and only their subject
# is logged.
# ---------------------------------------------------------------------------

# FLASHCARDS_SMTP_HOST=smtp.example.org
# FLASHCARDS_SMTP_PORT=587
# "starttls" (usually 587), "ssl" (usually 465) or "none" (a local relay only;
# the API refuses to start with "none" and a username or password).
# FLASHCARDS_SMTP_SECURITY=starttls
# FLASHCARDS_SMTP_USERNAME=
# FLASHCARDS_SMTP_PASSWORD=
# FLASHCARDS_SMTP_SENDER=Flash-Cards <no-reply@example.org>
